# Honeyguide server configuration.
# Copy to .env next to docker-compose.yml and fill in; docker compose loads
# it automatically. Keep the real .env out of git and chmod 600 on servers.

# Port the container listens on (compose maps it to the host).
PORT=3000

# Redis for the BullMQ queue. The compose stack provides this service;
# only change it if you run Redis elsewhere.
REDIS_URL=redis://redis:6379

# Ollama instance the server uses for rationale generation.
# - Ollama on the VPS host itself: http://host.docker.internal:11434
#   (add `extra_hosts: ["host.docker.internal:host-gateway"]` on Linux)
# - Ollama as a compose service: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434

# Bearer key sent as `Authorization: Bearer <key>` to the Ollama instance,
# for setups where Ollama sits behind an authenticating reverse proxy.
# Leave empty if your Ollama is reachable without auth (e.g. localhost only).
# Note: this is the server's own service credential. Users' BYO keys are a
# different thing and are never persisted server-side (ADR-0004).
OLLAMA_API_KEY=

# Model for rationale generation; tasks are sized for 4B–8B models (spec §8).
OLLAMA_MODEL=llama3.1:8b

# Optional retrieval capabilities — leave empty to run without them; the
# affected component reports 'unavailable' instead of failing (ADR-0006).
# YouTube Data API v3 key enables video retrieval. Deliberately NOT set on
# the public hosted instance: search costs 100 quota units of the 10k/day
# default, so a shared key would be exhausted (or abused) within hours.
# It is a bring-your-own-key feature for self-host and desktop.
YOUTUBE_API_KEY=
# A SearXNG instance URL enables general-web retrieval. The compose stack
# ships one behind a profile: `docker compose --profile websearch up -d`,
# then set SEARXNG_URL=http://searxng:8080 and a random SEARXNG_SECRET
# (openssl rand -hex 32). Needs deploy/searxng/settings.yml alongside.
SEARXNG_URL=
SEARXNG_SECRET=
# Alternative web-search providers (ADR-0013). A SearXNG instance wins when
# configured; otherwise the first keyed provider below is used. Any one is
# enough — you do not need all of them.
BRAVE_API_KEY=
SERPER_API_KEY=
# Semantic Scholar API key lifts the keyless shared-pool throttling on paper
# search. Optional; paper discovery works without it (ADR-0013).
SEMANTIC_SCHOLAR_API_KEY=
# Optional local System One re-ranking (ADR-0016), preferred over embeddings.
# Requires Ollama 0.35+ and a decision model: ollama pull tev1:4b.
DECISION_URL=
DECISION_MODEL=tev1:4b
DECISION_API_KEY=
# Optional embedding re-ranking (ADR-0015), used when no decision model is set.
# Pull an embedding model first: ollama pull nomic-embed-text.
EMBEDDING_URL=
EMBEDDING_MODEL=nomic-embed-text
# Bearer key only if embeddings sit behind an authenticating proxy.
EMBEDDING_API_KEY=
# Contact email sent to Crossref/OpenAlex polite pools (better rate limits).
HONEYGUIDE_MAILTO=

# Batch input (many topics per request) is on by default for self-hosters.
# The public free-tier instance sets 0 (spec §9: batch is a tier feature).
HONEYGUIDE_ALLOW_BATCH=1
