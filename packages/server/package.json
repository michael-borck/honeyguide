{
  "name": "@michaelborck/honeyguide-server",
  "version": "0.7.2",
  "private": true,
  "description": "Honeyguide server: exposes core over JSON, queues long work with BullMQ.",
  "license": "MIT",
  "author": "Michael Borck",
  "type": "module",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@michaelborck/honeyguide-core": "*",
    "bullmq": "^5.12.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "typescript": "^5.5.0"
  }
}
